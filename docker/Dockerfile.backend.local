# 로컬 개발용 백엔드 이미지 — Azure CLI 포함
# docker compose 가 이 파일을 사용함 (docker/Dockerfile.backend 는 배포 전용)
#
# 최초 1회 로그인:
#   docker compose exec be az login --use-device-code

FROM ghcr.io/astral-sh/uv:0.6.14 AS uv

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Azure CLI 의존 패키지 + Azure CLI 설치
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg lsb-release \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -sLS https://packages.microsoft.com/keys/microsoft.asc \
       | gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] \
https://packages.microsoft.com/repos/azure-cli/ $(lsb_release -cs) main" \
       > /etc/apt/sources.list.d/azure-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends azure-cli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --extra chat

COPY backend/ ./

ENV PATH="/app/.venv/bin:$PATH" \
    PORT=5100

EXPOSE 5100

CMD ["sh", "-c", "exec python main.py --port \"${PORT}\""]
