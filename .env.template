# Microsoft Agent Framework Configuration
# https://github.com/microsoft/agent-framework
# pip install agent-framework --pre

# Entra ID SSO (OIDC · MSAL 기밀 클라이언트)
AZURE_AUTH_CLIENT_ID=SSO-CLIENT-ID
AZURE_AUTH_TENANT_ID=SSO-TENANT-ID

# Entra가 리다이렉트할 백엔드 콜백 경로 `/api/getAToken` (Entra 앱 등록의 Web redirect URI 와 동일해야 함)
# 로컬은 docker 컨테이너(nginx :80) 기준
AZURE_AUTH_REDIRECT_URI=http://localhost/api/getAToken

# OAuth state 반복공격 방지용 HMAC 키(임의 장문 문자열 · Entra에 등록하지 않음, 16자 이상 권장)
AZURE_AUTH_STATE_SECRET=LONG-RANDOM-SECRET

# 인증 쿠키 Secure 강제 — 배포(https)는 true. 로컬 docker(http)는 미설정(스킴 기준 자동 판단)
# COOKIE_SECURE=true

# ── 클라이언트 인증: 아래 둘 중 하나 (둘 다 있으면 CLIENT_SECRET 우선) ──
# (로컬 개발) Entra 앱의 client secret · UAMI 페더레이션 불필요
AZURE_AUTH_CLIENT_SECRET=your-client-secret-here
# (배포) UAMI 페더레이션: AZURE_AUTH_SSO_UAMI_CLIENT_ID 설정, 생략 시 AZURE_RESOURCE_READER_UAMI_CLIENT_ID 재사용

# Azure AI Foundry root endpoint and project name
AZURE_AI_ENDPOINT=https://<foundry>.services.ai.azure.com
AZURE_AI_PROJECT_NAME=proj-default

# Model Deployment Name
# Check the deployment name in Azure AI Foundry > Management > Deployments.
AZURE_AI_MODEL_DEPLOYMENT_NAME=MODEL

# PostgreSQL DB connection
# Setting DB_HOST enables DB mode; leaving it empty uses file-based storage.
DB_HOST=DB-HOST
DB_PORT=DB-PORT
DB_NAME=DB-SCHEMA
DB_USER=DB-USERNAME
DB_PASSWORD=DB-PASSWORD

# v2 결정론 평가(/api/v2) 라우터 등록 스위치. true 일 때만 enterprise 경로가 노출된다.
# ENTERPRISE_ASSESSMENT_ENABLED=true

# Resource discovery/assessment Managed Identity
# Set Client ID to use a User-Assigned MI for subscription intersection and Resource Graph queries.
# Leave empty to use the default credential, such as the backend Web App System-Assigned MI.
AZURE_RESOURCE_READER_UAMI_CLIENT_ID=UAMI-CLIENT-ID
AZURE_RESOURCE_READER_UAMI_OBJECT_ID=UAMI-OBJECT-ID
AZURE_RESOURCE_READER_UAMI_RESOURCE_ID=UAMI-RESOURCE-ID
AZURE_RESOURCE_READER_UAMI_NAME=UAMI-NAME
